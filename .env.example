SEISMIC_BASE_URL=https://api.seismic-dev.com/qa/livedoc
SEISMIC_API_TOKEN=
PORT=3001

# LLM backend: set LLMG_BASE_URL to use the Seismic LLM Gateway instead of local Ollama
# (Node fetch needs NODE_USE_ENV_PROXY=1 + HTTPS_PROXY to reach *.seismic-dev.com)
LLMG_BASE_URL=
LLMG_TOKEN=
LLMG_MODEL=gpt-5.4-2026-03-05
LLMG_FEATURE_ID=demo
